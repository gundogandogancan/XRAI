{
  "project": "XRAI",
  "version": "1.0",
  "agents": [
    {
      "agentId": "IntentRouter",
      "status": "SPECIFIED_NOT_IMPLEMENTED",
      "specialization": "intent_classification",
      "purpose": "user-provided request to limited relevant domain tasks",
      "allowedCapabilities": [
        "local parser",
        "consent-aware policies"
      ],
      "forbidden": [
        "never sends data or makes life decision",
        "cannot change consent or product constitution",
        "cannot access raw vault outside authorized task",
        "cannot self-verify"
      ],
      "entryCondition": "TaskRouter selects only for relevant request, all privacy/rights gates passed",
      "inputContract": [
        "redacted authorized task",
        "epistemic tags",
        "privacy context",
        "budget",
        "relevant retrieved source references"
      ],
      "outputContract": [
        "result",
        "source and uncertainty",
        "proposed user action",
        "risk/cost",
        "self-check",
        "independent review needed flag"
      ],
      "memoryPolicy": "minimal task-scoped memory, user-approved long term claims only",
      "testSuites": [
        "GOLDEN_DOMAIN",
        "ADVERSARIAL_INJECTION",
        "PRIVACY",
        "EPISTEMIC_SEPARATION",
        "COST_LATENCY"
      ],
      "scoreDimensions": [
        "correctness",
        "evidence quality",
        "calibration",
        "privacy",
        "safety",
        "user autonomy",
        "cost",
        "latency"
      ],
      "fallback": "deterministic local user-controlled fallback or state unavailable",
      "budget": {
        "tokenCeiling": "to be benchmarked",
        "timeCeiling": "per task SLO",
        "frequency": "on demand not background constant"
      },
      "manuals": [
        "DomainManual",
        "ToolManual",
        "TestRubric",
        "EscalationRunbook"
      ]
    },
